#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot FALLBACK autostart (primary runs root-side via /data/adb/service.d).
# WHY "|| true": if sshd is already listening (e.g. root script ran first) the
# bind fails with an error — harmless, breathing is not an exit for the session.
termux-wake-lock
sshd || true
